# Line endings are not a style question here, they are a correctness one.
#
# `output/golden-tiny/` is a fixture: tests/test_golden.py asserts that a fresh
# run reproduces it byte for byte. The harness writes LF everywhere
# (novaforge/security/sandbox.py opens files with newline="\n"), so if git
# checked those files out with CRLF on Windows, every byte comparison would
# fail on a fresh clone and the fixture would be worthless.
#
# So: LF in the repository and LF in the working tree, on every platform.
* text=auto eol=lf

# Binary, and byte-exact. The PDF's cross-reference table is a list of byte
# offsets; a single inserted CR shifts every one of them and no reader will
# open the file.
*.pdf binary
*.png binary
*.jpg binary

# Generated by a run rather than written by hand. Marking them keeps
# `git diff --stat` and GitHub's language stats honest about what is source.
output/golden-tiny/** linguist-generated=true
