# Runs are output, not source. There is no committed fixture on this branch —
# nothing here reproduces, so a committed run would be a sample rather than
# something a diff could check. `main` has one, in output/golden-tiny/.
output/

# Credentials. This branch handles no API key of its own — Claude Code holds
# the credential — but a stray .env is the usual way one reaches a repository
# anyway, and the rule costs nothing to keep.
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
