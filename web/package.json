{
  "name": "novaforge-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only viewer for NovaForge runs. Reads the files the pipeline already writes; launches nothing, calls no model, writes nothing.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types smoke.mts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "yaml": "^2.6.1"
  }
}
